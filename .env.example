# GEMINI_API_KEY is a server-side secret. Never rename it to VITE_GEMINI_API_KEY;
# VITE_* variables are exposed in the browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Firebase web-app configuration. These values identify the Firebase app;
# secure access with Firebase Authentication, Firestore rules, and API restrictions.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# APP_URL: Optional public URL where the app is hosted.
APP_URL="https://your-domain.example"
