{
  "id": "/",
  "name": "تواصل - Wasil Messenger",
  "short_name": "تواصل",
  "description": "تطبيق تواصل اجتماعي متكامل مستوحى من واتساب مع تشفير تام بين الطرفين ومكالمات صوتية ومرئية ومزامنة فورية عبر Firebase.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#008069",
  "background_color": "#EAE6DF",
  "categories": ["social", "communication", "productivity"],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.wasil.messenger",
      "url": "https://play.google.com/store/apps/details?id=com.wasil.messenger"
    },
    {
      "platform": "webapp",
      "url": "https://whats-app-px5v.vercel.app/manifest.json"
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "واجهة تواصل على سطح المكتب مع المحادثات المشفرة والرسائل الصوتية"
    },
    {
      "src": "/screenshots/mobile-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "واجهة تواصل على الجوال مع الحالات اليومية وقائمة الدردشات"
    }
  ],
  "shortcuts": [
    {
      "name": "محادثة جديدة",
      "short_name": "محادثة",
      "description": "بدء محادثة مشفرة جديدة",
      "url": "/?action=new-chat",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الحالات والقصص",
      "short_name": "الحالات",
      "description": "استعراض الحالات اليومية",
      "url": "/?tab=status",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+wasil",
      "url": "/?chat=%s"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
